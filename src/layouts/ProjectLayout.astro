---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, subtitle, grade, techStack } = entry.data;
---

<BaseLayout title={title} description={subtitle}>
  <article class="max-w-4xl mx-auto animate-in">
    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="px-3 py-1 rounded-full text-sm font-medium bg-forest-100 text-forest-700 dark:bg-forest-800 dark:text-forest-200">
          {grade} 级项目
        </span>
        {techStack.map((t: string) => <span class="tag">{t}</span>)}
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-text-primary mb-2">{title}</h1>
      <p class="text-lg text-text-secondary">{subtitle}</p>
    </header>
    <slot />
  </article>
</BaseLayout>
