---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const blogPosts = await getCollection('blog');
const gardenEntries = await getCollection('garden');
---

<BaseLayout title="搜索" description="搜索全部内容">
  <section class="max-w-2xl mx-auto animate-in">
    <h1 class="text-4xl font-bold text-text-primary mb-8">🔍 搜索</h1>

    <div id="search-container">
      <div id="search-input-wrapper" class="mb-8">
        <input
          type="text"
          id="search-input"
          placeholder="输入关键词搜索..."
          class="w-full px-6 py-4 text-lg rounded-2xl border border-forest-100/20 bg-bg-card text-text-primary placeholder-text-secondary/50 focus:outline-none focus:border-forest-400 focus:ring-2 focus:ring-forest-400/20 transition-all"
        />
      </div>
      <div id="search-results" class="space-y-4">
        <p class="text-center text-text-secondary py-8">输入关键词开始搜索 🔍</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const allContent = [
    ...Astro.props.projects.map(p => ({ type: '💻 项目', title: p.data.title, desc: p.data.subtitle, url: `/projects/${p.id}`, tags: p.data.techStack.join(' ') })),
    ...Astro.props.blogPosts.map(p => ({ type: '📝 博客', title: p.data.title, desc: p.data.description, url: `/blog/${p.id}`, tags: p.data.tags.join(' ') })),
    ...Astro.props.gardenEntries.map(p => ({ type: '🌱 成长', title: p.data.title, desc: p.data.description || '', url: `/garden#cat-${p.data.category}`, tags: p.data.tags.join(' ') })),
  ];

  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');

  input.addEventListener('input', () => {
    const query = input.value.toLowerCase().trim();
    if (!query) {
      results.innerHTML = '<p class="text-center text-text-secondary py-8">输入关键词开始搜索 🔍</p>';
      return;
    }

    const matches = allContent.filter(item =>
      item.title.toLowerCase().includes(query) ||
      item.desc.toLowerCase().includes(query) ||
      item.tags.toLowerCase().includes(query)
    ).slice(0, 20);

    if (matches.length === 0) {
      results.innerHTML = '<p class="text-center text-text-secondary py-8">没有找到相关内容</p>';
    } else {
      results.innerHTML = matches.map(m => `
        <a href="${m.url}" class="card block group">
          <div class="text-xs text-forest-400 mb-1">${m.type}</div>
          <div class="text-text-primary font-medium group-hover:text-forest-500 transition-colors">${m.title}</div>
          <div class="text-sm text-text-secondary mt-1">${m.desc || ''}</div>
        </a>
      `).join('');
    }
  });
</script>
