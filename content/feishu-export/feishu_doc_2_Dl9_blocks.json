      {
        "block_id": "FVIIdSbRjoKUl5xuu1qceQEInOh",
        "block_type": 27,
        "image": {
          "align": 2,
          "height": 1605,
          "scale": 0.6160337552742616,
          "token": "O1bmb3zHuoAYttxh5HbcmPQ0nNg",
